{
    "name": "crustum/prompts",
    "description": "Beautiful interactive CLI prompts for CakePHP Console",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "prompts",
        "console",
        "cli",
        "interactive"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "cakephp/cakephp": "6.x-dev",
        "laravel/prompts": "^0.3.21"
    },
    "require-dev": {
        "cakephp/bake": "4.x-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8 || ^4.1",
        "pestphp/pest-plugin-type-coverage": "^3.6 || ^4.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.5.5 || ^12.5 | ^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "ext-pcntl": "Required for the spinner to be animated."
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Prompts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestApp\\": "tests/TestApp/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/",
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "update:lowest": "composer update --prefer-lowest --prefer-stable --prefer-dist --no-progress",
        "test:lowest": [
            "@update:lowest",
            "@test"
        ],
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform-check": false
    }
}
